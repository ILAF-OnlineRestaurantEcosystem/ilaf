# انسخ هذا الملف باسم .env وحط مفتاح واحد على الأقل (بدون مفاتيح: نديم بيشتغل بالوضع الأساسي)

# مفتاح Gemini المجاني من https://aistudio.google.com/apikey
GEMINI_API_KEY=

# أو مفتاح Claude من https://platform.claude.com (مدفوع حسب الاستعمال، وإذا موجود بيتقدّم على Gemini)
ANTHROPIC_API_KEY=

# اختياري: الموديلات (الافتراضي: Claude Opus 5.5، وأحدث Gemini flash)
# CLAUDE_MODEL=claude-opus-5-5
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_THINKING=minimal   (minimal = أسرع رد، low/medium = أذكى بس أبطأ)

# اختياري: المنفذ
# PORT=3000

# لاحقاً (خبير قواعد البيانات): رابط PostgreSQL — شوف docs/HANDOVER.md
# DATABASE_URL=postgres://user:pass@host:5432/ilaf

# على السيرفر الحقيقي (شوف docs/SECURITY.md):
# NODE_ENV=production
# TRUST_PROXY=1        (السيرفر ورا Caddy/Nginx)
# HSTS=1               (بعد ما يشتغل HTTPS)
# ALLOWED_ORIGINS=     (دومينات ثانية مسموح تتصل بالـ Socket.io، مفصولة بفاصلة)
